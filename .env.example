# Site URL (canonical / Open Graph / sitemap). Default: https://meros.app
NEXT_PUBLIC_SITE_URL=https://meros.app

# Destination inbox for "Partner with us" form submissions
PARTNER_INBOX=partners@example.com

# Email provider: stub | resend | smtp | ses
EMAIL_PROVIDER=resend

# --- Resend (recommended) ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- AWS SES (API) — optional later ---
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@meros.app

# --- AWS SES SMTP — optional later ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@meros.app
