# Site URL (canonical / Open Graph / sitemap). Default: https://meros.app
NEXT_PUBLIC_SITE_URL=https://meros.app

# Destination inbox for "Partner with us" form submissions (server-only preferred).
# Must be an email address. Also accepted: PARTNER_WITH_US
PARTNER_INBOX=partners@example.com

# Email provider: stub | smtp | ses
# stub = logs in server console (local/dev until AWS is wired)
EMAIL_PROVIDER=stub

# --- AWS SES (API) — enable when ready ---
# EMAIL_PROVIDER=ses
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=noreply@meros.app

# --- AWS SES SMTP (or any SMTP) — enable when ready ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@meros.app
